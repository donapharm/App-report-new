# GATE2 PREVIEW ONLY. No secrets in this template.
EMPLOYEE_COST_WATCH_STATE_DIR=/VAR/LIB/app-report/snapshot-watcher
EMPLOYEE_COST_WATCH_LOCK_FILE=/VAR/LOCK/app-report-snapshot-watcher.lock
APP_REPORT_ACTIVITY_MARKER=/home/osboxes/.openclaw/workspace-report-dev/artifacts/app-report-current-activity.txt
EMPLOYEE_COST_SNAPSHOT_WATCH_MODE=probe
EMPLOYEE_COST_SNAPSHOT_WATCH_NOTIFY=0
# Gate 2 resolves TELEGRAM_BOT_TOKEN from the protected runtime env; never place its value in Git.
# TELEGRAM_BOT_TOKEN=<protected runtime secret>
# Interlock: watcher refuses to probe/sync unless legacy warm and snapshot loop are off.
EMPLOYEE_COST_ALL_WARM_DISABLED=1
EMPLOYEE_COST_LOCAL_SNAPSHOT_SYNC_ENABLED=0
# Fail-closed declaration: any independent employee-cost cron must be disabled.
EMPLOYEE_COST_CRON_DISABLED=1
# Serve remains OFF and watcher refuses to run if this is 1.
EMPLOYEE_COST_SERVE_FROM_SNAPSHOT=0
# Gate2 may change WATCH_MODE to sync only after a probe-ready review.
